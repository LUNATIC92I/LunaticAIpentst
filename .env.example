# ─────────────────────────────────────────────────────────────────────────────
# LUNATIC PENTEST AI — environment template
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# Integrations left blank report a NOT_CONFIGURED state instead of faking output.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://lunatic:lunatic@localhost:5432/lunatic?schema=public
POSTGRES_USER=lunatic
POSTGRES_PASSWORD=lunatic
POSTGRES_DB=lunatic

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth / crypto ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900           # seconds (15 min)
JWT_REFRESH_TTL=2592000      # seconds (30 days)
# 32-byte key (base64) used to envelope-encrypt stored provider API keys.
SECRETS_ENCRYPTION_KEY=change-me-32-byte-base64-key
MFA_ISSUER=LunaticPentestAI
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- AI providers (optional; blank => NOT_CONFIGURED) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# --- Sandbox execution ---
# driver = docker | e2b
SANDBOX_DRIVER=docker
SANDBOX_DEFAULT_IMAGE=lunatic/kali-tools:latest
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=2048          # MB
SANDBOX_DISK_LIMIT=4096            # MB
SANDBOX_WALLCLOCK_LIMIT=1800       # seconds
SANDBOX_RETENTION_SECONDS=86400
E2B_API_KEY=

# --- Object storage (S3-compatible; evidence/files) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=lunatic-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Billing (Stripe; optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Observability (optional) ---
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# --- Local agent ---
LOCAL_AGENT_ENROLLMENT_SECRET=change-me-enrollment
