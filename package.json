{
  "name": "lunatic-pentest-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Professional AI-assisted pentesting platform (authorized operations only).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev": "pnpm -r --parallel dev",
    "db:generate": "pnpm --filter @lunatic/database db:generate",
    "db:migrate": "pnpm --filter @lunatic/database db:migrate",
    "db:seed": "pnpm --filter @lunatic/database db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "typescript": "5.7.3"
  }
}
